<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM UI Automation Suite" verbose="1">
    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="true"/>
    <parameter name="baseUrl" value="https://opensource-demo.orangehrmlive.com/web/index.php/auth/login"/>
    <parameter name="timeoutSeconds" value="15"/>

    <listeners>
        <listener class-name="support.TestListener"/>
    </listeners>

    <test name="Login and Dashboard">
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.DashboardTest"/>
        </classes>
    </test>

    <test name="TestNG Lifecycle Demonstration">
        <classes>
            <class name="tests.LifecycleAnnotationsTest"/>
        </classes>
    </test>
</suite>
